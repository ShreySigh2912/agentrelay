{
  "name": "@shrey_singh/agentrelay",
  "version": "0.1.1",
  "description": "Self-hosted AI agent gateway for WhatsApp, Telegram & Discord",
  "type": "module",
  "bin": {
    "agentrelay": "./bin/cli.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "author": "Shrey Singh <shreysingh29@gmail.com>",
  "homepage": "https://github.com/ShreySigh2912/agentrelay",
  "scripts": {
    "start": "node bin/cli.js gateway",
    "dev": "node --watch bin/cli.js gateway",
    "build:ui": "cd src/web/ui && npm run build"
  },
  "keywords": [
    "ai",
    "whatsapp",
    "telegram",
    "discord",
    "gateway",
    "chatbot",
    "gemini",
    "claude",
    "openai",
