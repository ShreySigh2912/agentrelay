  "repository": {
    "type": "git",
    "url": "https://github.com/ShreySigh2912/agentrelay.git"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "@google/generative-ai": "latest",
    "@whiskeysockets/baileys": "latest",
    "boxen": "latest",
    "chalk": "latest",
    "commander": "latest",
    "conf": "latest",
    "discord.js": "latest",
    "dotenv": "latest",
    "express": "latest",
    "gradient-string": "latest",
    "grammy": "latest",
    "inquirer": "latest",
    "openai": "latest",
    "ora": "latest",
    "socket.io": "latest"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.27",
